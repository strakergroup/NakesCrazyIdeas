# Default: no external model requests and no preinstalled credentials.
CAS_DB=var/assurance.sqlite3
CAS_MODE=local
CAS_PROVIDER=disabled
CAS_PROVIDER_URL=
CAS_PROVIDER_MODEL=
CAS_PROVIDER_API_KEY=
CAS_ALLOW_EXTERNAL=false
CAS_PROVIDER_TIMEOUT=20
CAS_JOB_LEASE=180
CAS_JOB_ATTEMPTS=3
# Only local demonstration servers can use CAS_PROVIDER=fixture.
# Use `assurance init --demo` to create explicitly labelled local credentials.
